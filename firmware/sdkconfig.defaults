# Placa: ESP32-S3-WROOM-1 N16R8 (16 MB de flash, 8 MB de PSRAM octal)
CONFIG_IDF_TARGET="esp32s3"

# CPU (o padrão do ESP-IDF para o S3 é 160 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Configuração adotada na prova de viabilidade (cenário B):
# - open62541 na PSRAM: libera ~110 KB de SRAM interna sem custo de latência mensurável
# - economia de energia do Wi-Fi ligada: desligá-la não reduziu a latência e
#   causou travamentos esporádicos de ~1 s e falhas de conexão
CONFIG_OPEN62541_ALOCAR_PSRAM=y
CONFIG_TCC_WIFI_ECONOMIA_ENERGIA=y
